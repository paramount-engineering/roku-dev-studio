{
  "name": "roku-dev-studio-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Roku Dev Studio — cross-platform desktop app and CLI for Roku development: ECP remote control, BrightScript sideload, RALE/App Connector, Network Inspector, Action Scripts, MCP server for AI agents",
  "homepage": "https://github.com/paramount-engineering/roku-dev-studio#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npx tsx apps/roku-dev-studio/scripts/build/index.ts && npx tsx apps/roku-dev-studio/scripts/run-electron.ts",
    "start:solid": "npm run dev:solid -w roku-dev-studio",
    "wiz:scan": "wizcli scan dir . --use-device-code --by-policy-hits=DISABLED --json-output-file=.wiz/wiz-results.json --sarif-output-file=.wiz/wiz-results.sarif --human-output-file=.wiz/wiz-results.txt",
    "wiz:export-findings": "node .wiz/wiz-findings-to-md.js",
    "postinstall": "npm run build:libs",
    "build:libs": "npm run build -w roku-dev-studio-platform && npm run build -w roku-dev-studio-api",
    "build": "npm --prefix apps/roku-dev-studio run build",
    "build:mac": "npm --prefix apps/roku-dev-studio run build:mac",
    "build:win": "npm --prefix apps/roku-dev-studio run build:win",
    "build:win:diagnostic": "npm --prefix apps/roku-dev-studio run build:win:diagnostic",
    "build:mac:diagnostic": "npm --prefix apps/roku-dev-studio run build:mac:diagnostic",
    "build:linux:diagnostic": "npm --prefix apps/roku-dev-studio run build:linux:diagnostic",
    "build:all:diagnostic": "npm --prefix apps/roku-dev-studio run build:all:diagnostic",
    "build:linux": "npm --prefix apps/roku-dev-studio run build:linux",
    "build:all": "npm --prefix apps/roku-dev-studio run build:all",
    "remote-server": "cd packages/roku-dev-studio-remote-server && node roku-remote-server.js",
    "rds": "node packages/roku-dev-studio-api/dist/cli.js",
    "ci:api": "node -e \"require('roku-dev-studio-api'); console.log('roku-dev-studio-api ok')\" && node packages/roku-dev-studio-api/dist/cli.js --help >/dev/null",
    "ci:remote-check": "npm run build -w roku-dev-studio-remote-server && node --check packages/roku-dev-studio-remote-server/roku-remote-server.js",
    "ci:app-check": "npx tsx apps/roku-dev-studio/scripts/build/index.ts && node --check apps/roku-dev-studio/main.bundled.cjs",
    "typecheck:platform": "npm run typecheck -w roku-dev-studio-platform",
    "typecheck:api": "npm run typecheck -w roku-dev-studio-api",
    "typecheck:mcp": "npm run typecheck -w roku-dev-studio-mcp",
    "typecheck:network-inspector": "npm run typecheck -w roku-dev-studio-network-inspector",
    "typecheck:electron": "npm run typecheck:electron -w roku-dev-studio",
    "typecheck:renderer": "npm run typecheck:renderer -w roku-dev-studio",
    "typecheck:remote-server": "npm run typecheck -w roku-dev-studio-remote-server",
    "typecheck": "npm run typecheck:platform && npm run typecheck:api && npm run typecheck:mcp && npm run typecheck:network-inspector && npm run typecheck:electron && npm run typecheck:renderer && npm run typecheck:scripts -w roku-dev-studio && npm run typecheck:remote-server && npm run renderer:solid:typecheck -w roku-dev-studio",
    "test": "npm test --workspaces --if-present"
  },
  "license": "MIT"
}
