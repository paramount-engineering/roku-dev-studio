packages/roku-dev-studio-remote-server/roku-remote-server.js
# Same MITM leaf-cert worker_threads entry as the desktop app above, built separately for this process.
packages/roku-dev-studio-remote-server/leaf-cert.worker.js

# Legacy renderer: all emitted ESM lives under renderer/dist/ (see build-legacy-renderer-modules.js)
apps/roku-dev-studio/renderer/dist/

# Vendored ESM copy (see transpile-renderer.ts); keep `renderer/vendor/*.d.ts` in git
apps/roku-dev-studio/renderer/vendor/*.mjs

# Solid + Vite renderer production build (see apps/roku-dev-studio/vite.config.ts)
apps/roku-dev-studio/renderer-vite-dist/

