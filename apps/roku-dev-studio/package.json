{
  "name": "roku-dev-studio",
  "version": "1.1.0",
  "description": "Roku Dev Studio - Control your Roku device over the local network",
  "homepage": "https://github.com/paramount-engineering/roku-dev-studio",
  "main": "main.bundled.cjs",
  "private": true,
  "scripts": {
    "start": "tsx scripts/build/index.ts && tsx scripts/run-electron.ts",
    "renderer:solid:build": "vite build",
    "renderer:solid:dev": "vite --host 127.0.0.1",
    "renderer:solid:typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "pretypecheck:renderer": "tsx scripts/build/ensure-modern-screenshot-vendor.ts && tsx scripts/build/ensure-tanstack-virtual-vendor.ts",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "verify:structured-pills": "tsx scripts/verify-structured-pills.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "dev:solid": "tsx scripts/build/index.ts && concurrently -k \"npm run renderer:solid:dev\" \"wait-on tcp:127.0.0.1:5173 && cross-env RDS_SOLID_RENDERER=1 tsx scripts/run-electron.ts\"",
    "build:desktop": "tsx scripts/build/index.ts",
    "build:preload": "tsx scripts/build/index.ts",
    "build:bundle": "tsx scripts/build/index.ts",
    "prepare": "node -e \"if (process.env.CI) process.exit(0); require('child_process').execSync('npm run build:bundle', { stdio: 'inherit' })\"",
    "clean:dist": "tsx scripts/cleanup-old-builds.ts",
    "build": "npm run build:bundle && npm run clean:dist && electron-builder",
    "build:mac": "npm run build:bundle && npm run clean:dist && electron-builder --mac",
    "build:mac:intel": "npm run build:bundle && npm run clean:dist && electron-builder --mac dmg:x64 zip:x64",
    "build:win": "npm run build:bundle && npm run clean:dist && electron-builder --win",
    "build:win:diagnostic": "tsx scripts/build-diagnostic.ts win",
    "build:mac:diagnostic": "tsx scripts/build-diagnostic.ts mac",
    "build:linux:diagnostic": "tsx scripts/build-diagnostic.ts linux",
    "build:all:diagnostic": "tsx scripts/build-diagnostic.ts all",
    "build:linux": "npm run build:bundle && npm run clean:dist && electron-builder --linux",
    "build:all": "npm run build:bundle && npm run clean:dist && concurrently --names mac,linux,win --prefix-colors cyan,green,magenta \"electron-builder --mac -c.npmRebuild=false\" \"electron-builder --linux -c.npmRebuild=false\" \"electron-builder --win -c.npmRebuild=false\""
  },
  "author": {
    "name": "Hareendra Donapati",
    "email": "hareendra.donapati@paramount.com",
    "url": "https://github.com/hdonapati"
  },
  "company": "Paramount Streaming",
  "license": "MIT",
  "dependencies": {
    "@tanstack/virtual-core": "^3.17.3",
    "brighterscript": "^0.73.0",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "roku-dev-studio-api": "file:../../packages/roku-dev-studio-api",
    "roku-dev-studio-mcp": "file:../../packages/roku-dev-studio-mcp",
    "roku-dev-studio-platform": "file:../../packages/roku-dev-studio-platform",
    "solid-js": "^1.9.14",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "cap": "^0.2.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^24.9.1",
    "esbuild": "0.28.1",
    "jsdom": "^24.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.6",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.paramount.vtg.roku-dev-studio",
    "productName": "Roku Dev Studio",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "paramount-engineering",
      "repo": "roku-dev-studio"
    },
    "afterSign": "./scripts/notarize.cjs",
    "afterAllArtifactBuild": "./scripts/build-hooks-entry.cjs",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!dist/**",
      "!scripts/**",
      "!*.md",
      "!main/**/*.ts",
      "!renderer/**/*.ts",
      "!renderer/**/*.tsx",
      "!shared/**/*.ts",
      "!src/**/*.ts",
      "!src/**/*.tsx",
      "!main.ts",
      "!preload.ts",
      "!**/*.d.ts",
      "!**/*.map",
      "!tsconfig*.json",
      "!vite.config.ts",
      "!apps/**"
    ],
    "asarUnpack": [
      "**/node_modules/cap/**"
    ],
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.developer-tools",
      "files": [
        "!assets/icon.ico",
        "!assets/ico-parts/**",
        "!assets/icon.iconset/**"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "signIgnore": [
        "node_modules"
      ],
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "This app needs to discover and communicate with Roku devices on your local network.",
        "NSBonjourServices": [
          "_ssdp._udp",
          "_roku._tcp"
        ],
        "NSAppleEventsUsageDescription": "This app needs to communicate with other apps on your system."
      },
      "electronLanguages": [
        "en",
        "en_GB"
      ]
    },
    "win": {
      "files": [
        "!assets/icon.icns",
        "!assets/icon.iconset/**",
        "!assets/ico-parts/**",
        "!entitlements.mac.plist",
        "!scripts/notarize.cjs"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "files": [
        "!assets/icon.icns",
        "!assets/icon.ico",
        "!assets/icon.iconset/**",
        "!entitlements.mac.plist",
        "!scripts/notarize.cjs"
      ],
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/ico-parts",
      "synopsis": "Roku development and debugging tool",
      "description": "Roku Dev Studio - Control your Roku device over the local network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ],
      "packageCategory": "devel"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
