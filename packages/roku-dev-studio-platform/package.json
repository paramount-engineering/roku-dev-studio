{
  "name": "roku-dev-studio-platform",
  "version": "1.0.0",
  "description": "Shared host-platform helpers for Roku Dev Studio — OS identity, human labels, modifier keys (renderer-safe), plus node-only filesystem helpers. Used by the desktop app and other packages so platform logic lives in one place.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramount-engineering/roku-dev-studio.git",
    "directory": "packages/roku-dev-studio-platform"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "roku",
    "platform",
    "os",
    "cross-platform"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"if (process.env.CI) process.exit(0); require('fs').existsSync('dist/index.js') || require('child_process').execSync('npm run build', { stdio: 'inherit' })\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.25.12",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./device-ref": {
      "types": "./dist/device-ref.d.ts",
      "default": "./dist/device-ref.js"
    },
    "./ttl-cache": {
      "types": "./dist/ttl-cache.d.ts",
      "default": "./dist/ttl-cache.js"
    },
    "./async-patterns": {
      "types": "./dist/async-patterns.d.ts",
      "default": "./dist/async-patterns.js"
    },
    "./path-safe": {
      "types": "./dist/path-safe.d.ts",
      "default": "./dist/path-safe.js"
    }
  }
}
