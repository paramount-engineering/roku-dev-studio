{
  // Self-contained — intentionally does not extend the repo-root base. See
  // `packages/roku-dev-studio-api/tsconfig.json` for the same pattern and
  // rationale (deployment boxes may only ship the single package).
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["roku-remote-server.ts"]
}
