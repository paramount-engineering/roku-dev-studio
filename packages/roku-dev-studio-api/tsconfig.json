{
  // Package tsconfig is intentionally self-contained — no `extends` to the
  // repo-root `tsconfig.base.json`, because the package also gets built on
  // deployment boxes that may only have `packages/roku-dev-studio-api/` (no
  // repo root, no base config). The strict options below duplicate the base;
  // update both if the base changes.
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Transitional: many CLI/discovery/http callbacks still use implicit any; other strict flags remain on.
    "noImplicitAny": false,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "moduleDetection": "force",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["index.ts", "cli.ts", "ecp.ts", "relay-client.ts", "lib/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
