{
  "name": "roku-dev-studio-mcp",
  "version": "1.1.0",
  "description": "MCP server exposing Roku Dev Studio Action Scripts to AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roku",
    "brightscript",
    "ai-agent",
    "cursor",
    "claude",
    "developer-tools"
  ],
  "main": "dist/index.cjs",
  "bin": {
    "roku-dev-studio-mcp": "dist/index.cjs"
  },
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"if (process.env.CI) process.exit(0); require('fs').existsSync('dist/index.cjs') || require('child_process').execSync('npm run build', { stdio: 'inherit' })\""
  },
  "license": "MIT",
  "dependencies": {
    "roku-dev-studio-api": "file:../roku-dev-studio-api",
    "roku-dev-studio-platform": "file:../roku-dev-studio-platform"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
