{
  "name": "roku-dev-studio-network-inspector",
  "version": "1.0.0",
  "description": "Roku Dev Studio Network Inspector engine — hotspot packet capture (DNS/SNI/HTTP) + local MITM proxy, transport-agnostic so it runs in the desktop app and the remote server.",
  "main": "index.ts",
  "types": "index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paramount-engineering/roku-dev-studio.git",
    "directory": "packages/roku-dev-studio-network-inspector"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "keywords": [
    "roku",
    "network",
    "packet-capture",
    "mitm",
    "tcpdump"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "node-forge": "^1.4.0",
    "roku-dev-studio-api": "^1.0.0",
    "roku-dev-studio-platform": "^1.0.0"
  },
  "optionalDependencies": {
    "cap": "^0.2.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "22.19.21",
    "@types/node-forge": "1.3.14",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": "./index.ts",
    "./types": "./types.ts",
    "./prerequisites": "./prerequisites.ts",
    "./setup-guide": "./setup-guide.ts",
    "./packet-parser": "./packet-parser.ts",
    "./http-stream-parser": "./http-stream-parser.ts"
  }
}
